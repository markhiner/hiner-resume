# Tuya IoT Platform credentials — from your Cloud Development project's
# "Overview" tab at https://iot.tuya.com (see README.md for full setup steps).
TUYA_ACCESS_ID=your_access_id
TUYA_ACCESS_KEY=your_access_secret

# Data center region your Tuya/Smart Life account was created in.
# One of: us, eu, in, cn
TUYA_API_REGION=us

# Any single device ID from your account (Cloud project -> Devices tab, after
# linking your Tuya/Smart Life app account under Devices -> Link Tuya App
# Account). Used once at startup to resolve your account's UID so every
# linked device can be listed — it does not limit which lights show up.
TUYA_SEED_DEVICE_ID=your_device_id

# Optional: port the app listens on locally.
PORT=8000
